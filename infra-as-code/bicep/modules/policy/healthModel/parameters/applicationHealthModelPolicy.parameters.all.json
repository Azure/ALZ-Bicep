{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "parLocation": {
      "value": "swedencentral"
    },
    "parTargetResourceGroupName": {
      "value": "rg-application-healthmodels"
    },
    "parHealthModelName": {
      "value": "alz-application-healthmodel"
    },
    "parPolicyName": {
      "value": "Deploy-App-CloudHealth-ApplicationModel"
    },
    "parAssignmentName": {
      "value": "Deploy-App-CloudHealth"
    },
    "parDeployHealthModel": {
      "value": true
    },
    "parTelemetryOptOut": {
      "value": false
    },
    "parEnforcementMode": {
      "value": "Default"
    },
    "parIncludedResourceTypesGlobal": {
      "value": [
        "Microsoft.Insights/components",
        "Microsoft.KeyVault/vaults"
      ]
    },
    "parComputeResourceTypes": {
      "value": [
        "Microsoft.Web/sites",
        "Microsoft.Insights/components"
      ]
    },
    "parDataResourceTypes": {
      "value": [
        "Microsoft.Storage/storageAccounts",
        "Microsoft.DocumentDB/databaseAccounts",
        "Microsoft.DBforPostgreSQL/flexibleServers"
      ]
    },
    "parRoutingResourceTypes": {
      "value": [
        "Microsoft.Cdn/profiles",
        "Microsoft.Network/applicationGateways",
        "Microsoft.Network/trafficManagerProfiles",
        "Microsoft.ApiManagement/service"
      ]
    },
    "parAiResourceTypes": {
      "value": [
        "Microsoft.CognitiveServices/accounts"
      ]
    },
    "parConfigResourceTypes": {
      "value": [
        "Microsoft.AppConfiguration/configurationStores",
        "Microsoft.KeyVault/vaults"
      ]
    },
    "parDomainOverrides": {
      "value": {
        "data": {
          "tagFilters": [
            {
              "key": "dataClassification",
              "value": "confidential"
            }
          ]
        },
        "routing": {
          "tagFilters": [
            {
              "key": "environment",
              "value": "production"
            },
            {
              "key": "exposure",
              "value": "external"
            }
          ]
        },
        "ai": {
          "tagFilters": [
            {
              "key": "environment",
              "value": "production"
            },
            {
              "key": "workload",
              "value": "recommendations"
            },
            {
              "key": "criticality",
              "value": "high"
            }
          ]
        },
        "config": {
          "tagFilters": [
            {
              "key": "environment",
              "value": "production"
            },
            {
              "key": "workload",
              "value": "checkout"
            },
            {
              "key": "criticality",
              "value": "high"
            },
            {
              "key": "managedBy",
              "value": "application-team"
            },
            {
              "key": "costCenter",
              "value": "retail"
            }
          ]
        }
      }
    }
  }
}
