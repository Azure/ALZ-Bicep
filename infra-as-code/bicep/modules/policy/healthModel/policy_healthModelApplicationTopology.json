  "resources": {
    "modTopology": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[take(format('hm-application-topology-{0}', uniqueString(parameters('parHealthModelName'), deployment().name)), 64)]",
      "properties": {
        "expressionEvaluationOptions": {
