              "templateHash": "11583021171493768045"
            },
            "name": "ALZ Bicep - CloudHealth Health Model Topology",
            "description": "Preview (experimental): deploys a Microsoft CloudHealth health model with domain grouping entities and one discovery rule per subdomain."
          },
          "definitions": {
            "typTagFilter": {
              "type": "object",
              "properties": {
                "key": {
