                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "metadata": {
                "__bicep_export!": true,
                "description": "A subdomain discovered by its own discovery rule and grouped under its parent domain."
              }
            },
            "typDomain": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "subscriptionId": {
                  "type": "string"
                },
                "tagFilters": {
                  "type": "array",
